# ===========================================================================
# AgroInOne - Root Environment Configuration Example
# ===========================================================================

# --- Supabase Database & Auth Credentials (Required for Backend Gateway) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# --- Security & JWT Secret ---
JWT_SECRET=your-random-cryptographic-secret-min-32-chars

# --- Microservice Upstream Ports ---
ML_SERVER_URL=http://ml:5001
PORT=5000

# --- Frontend Client Configuration ---
VITE_API_URL=/api
VITE_BACKEND_URL=http://backend:5000
